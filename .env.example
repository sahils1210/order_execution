# =========================================
# ORDER GATEWAY - Environment Configuration
# =========================================

# Server
PORT=3000
NODE_ENV=production

# API Key Authentication (shared secret between gateway and client apps)
# Generate a strong random string: openssl rand -hex 32
GATEWAY_API_KEY=change-me-use-a-strong-random-secret

# =========================================
# Zerodha Kite API
# =========================================
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Token source: "env" (use KITE_ACCESS_TOKEN directly) or "service" (fetch from URL)
KITE_TOKEN_SOURCE=service
KITE_ACCESS_TOKEN=

# External token service URL (same as your existing apps)
TOKEN_SERVICE_URL=https://token-xdpxv.ondigitalocean.app/api/fetchToken

# Token auto-refresh time (HH:MM in IST, before market open)
TOKEN_REFRESH_TIME=08:05

# =========================================
# Database
# =========================================
# SQLite file path (relative or absolute)
DB_PATH=./data/orders.db

# =========================================
# Idempotency
# =========================================
# How long to remember idempotency keys (ms). Default: 5 minutes
IDEMPOTENCY_TTL_MS=300000

# =========================================
# Order Execution
# =========================================
# Maximum retries on transient Kite API failures (1 = one safe retry)
MAX_RETRIES=1

# Request timeout for Kite API calls (ms)
KITE_TIMEOUT_MS=5000

# =========================================
# Token architecture
# =========================================
# When TRUE, every non-master account request MUST carry
# accountTokens[accountId] in the request body. Missing → HTTP 422
# MISSING_ACCOUNT_TOKEN. Caller (Scalper) becomes the sole authority for
# client tokens; the gateway no longer falls back to its AccountRegistry
# token for non-master accounts.
#
# When FALSE (legacy/default), the gateway falls back to AccountRegistry
# tokens when accountTokens is absent. accountTokens is still honoured if
# supplied by the caller.
STRICT_ACCOUNT_TOKENS=false

# =========================================
# Dry-run mode (paper-trading outside market hours)
# =========================================
# When TRUE *and* NSE is currently closed (weekend OR weekday outside
# 09:15-15:30 IST), placeOrder skips Kite entirely. Order is recorded in DB
# with status ACCEPTED and kite_order_id = "DRYRUN-<14 hex>". Cancel/modify
# on DRYRUN-* IDs short-circuit to synthetic success.
#
# Strategies can use this to verify pair-matching logic on weekends without
# placing real orders. INSIDE market hours, dry-run is IMPOSSIBLE regardless
# of this flag — the time check is the safety gate.
#
# Default FALSE. Enable only when you want test runs; gateway is in dry-run
# mode whenever this is TRUE and market is closed. The /metrics endpoint
# shows a DRY_RUN_ACTIVE alert whenever this is currently in effect.
DRY_RUN_OUTSIDE_HOURS=false

# =========================================
# CORS (comma-separated allowed origins)
# =========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
